# اجرای بدون داکر با systemd.
#   sudo cp deploy/messenger.service /etc/systemd/system/
#   sudo systemctl enable --now messenger
[Unit]
Description=Messenger
After=network.target

[Service]
Type=simple
User=messenger
WorkingDirectory=/opt/messenger
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=DATA_DIR=/var/lib/messenger
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=5

# سخت‌گیری امنیتی
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/messenger

[Install]
WantedBy=multi-user.target
