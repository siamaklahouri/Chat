# بلوک سرور فقط برای __DOMAIN__ — به کانفیگ سایت‌های دیگر دست نمی‌زند.
# certbot بعداً بخش ssl را خودش به همین فایل اضافه می‌کند.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ www.__DOMAIN__;

    # کمی بیشتر از بیشینه‌ی حجم عکس (۸ مگابایت)
    client_max_body_size 12m;

    access_log /var/log/nginx/__DOMAIN__.access.log;
    error_log  /var/log/nginx/__DOMAIN__.error.log;

    location / {
        proxy_pass http://127.0.0.1:__APP_PORT__;
        proxy_http_version 1.1;

        # بدون این دو هدر، پیام زنده (وب‌سوکت) کار نمی‌کند.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 3600s;   # اتصال وب‌سوکت نباید زود قطع شود
        proxy_buffering off;        # آپلود و دانلود عکس روان بماند
    }
}
