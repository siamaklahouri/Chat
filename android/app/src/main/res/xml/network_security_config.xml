<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      دامنه‌ی اصلی همیشه باید روی HTTPS باشد؛ اتصال بدون رمزنگاری به آن رد می‌شود.

      کنار گواهی‌های سیستم، مرجع صدور خودِ سرور هم پذیرفته می‌شود. دلیلش این
      است که گواهی Let's Encrypt هر ۹۰ روز تمدید می‌خواهد و تمدید به اینترنت
      جهانی نیاز دارد؛ اگر آن قطع شود و گواهی منقضی شود، مرورگر میکروفون،
      دوربین و سرویس‌ورکر را قطع می‌کند و پیام صوتی و تماس می‌میرند. با این
      مرجع، سرور می‌تواند به گواهی ده‌ساله‌ی محلی سوئیچ کند و برنامه کامل
      کار کند.

      این اعتماد فقط به همین دامنه و همین آی‌پی داده می‌شود، نه به کل برنامه:
      اگر روزی کلید آن مرجع لو برود، فقط همین اتصال در خطر است.

      آی‌پی هم هست تا اگر DNS از کار افتاد بشود مستقیم به سرور وصل شد.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">9chat.ir</domain>
        <domain includeSubdomains="false">185.231.112.152</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/ninechat_ca" />
        </trust-anchors>
    </domain-config>

    <!--
      برای بقیه‌ی نشانی‌ها http مجاز است، چون کاربر ممکن است در نبود اینترنت به یک
      سرور محلی مثل http://192.168.1.5:3000 وصل شود. اندروید اجازه نمی‌دهد این
      استثنا را فقط به IPهای شبکه‌ی محلی محدود کنیم.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
